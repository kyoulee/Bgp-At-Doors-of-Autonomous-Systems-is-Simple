FROM alpine:3.19

RUN apk update && apk add --no-cache \
    frr \
    busybox \
    tini

RUN sed -i 's/zebra=no/zebra=yes/' /etc/frr/daemons && \
    sed -i 's/watchfrr_options=.*$/watchfrr_options=""/' /etc/frr/daemons

RUN touch /etc/frr/zebra.conf \
    /etc/frr/vtysh.conf

RUN printf "#!/bin/sh\n\
setup_bridge_with_ports () {\n\
    local br_name=\$1\n\
    echo \"Received bridge name: \$br_name\"\n\
    shift\n\
    if ! brctl show | grep -q \"$br_name\"; then \n\
        brctl addbr \"\$br_name\" \n\
        ip link set \"\$br_name\" up \n\
        echo \"Bridge \"\$br_name\" created and up.\" \n\
    fi \n\
    for port in \"\$@\"; do \n\
        if [ -d \"/sys/class/net/\$port\" ]; then \n\
            brctl addif \"\$br_name\" \"\$port\" \n\
            ip link set \"\$port\" up \n\
            echo \" -> Port \$port added to \$br_name\" \n\
        else \n\
            echo \" -> Error: \$port not found, skipping.\" \n\
        fi \n\
    done \n\
    brctl show\n\    
}\n\
echo \"Ethernat Setting Start\n\"\n\
setup_bridge_with_ports br0 eth0 eth1 \n\
echo \"Ethernat Setting Done\n\"\n" > /usr/local/bin/assign-bridge-start

RUN chmod +x /usr/local/bin/assign-bridge-start

RUN printf "#!/bin/sh\n\
/usr/local/bin/assign-bridge-start \n\
echo \"Docker Ethernat Setting Done\n\"\n" > /usr/local/bin/docker-ethernat-start

RUN chmod +x /usr/local/bin/docker-ethernat-start


RUN printf "#!/bin/sh\n\
/usr/local/bin/docker-ethernat-start\n\
/usr/lib/frr/zebra -d -F traditional -A 127.0.0.1 -s 90000000\n\
while true; do /bin/busybox sh ; done \n\
tail -f /dev/null\n" > /usr/lib/frr/docker-start

RUN chmod +x /usr/lib/frr/docker-start

CMD ["/sbin/tini", "--", "/usr/lib/frr/docker-start"]